# ---------------------------------------------------------------------------
# DNSentinel backend configuration. Copy to backend/.env (or export the vars).
# Every value has a safe default, so the API boots with an empty file.
# ---------------------------------------------------------------------------

# Allowed CORS origins, comma-separated. "*" is fine locally; in production
# set the dashboard URL, e.g. CORS_ORIGINS=https://dns-sentinel.vercel.app
CORS_ORIGINS=*

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
DEBUG=False

# When set, POST endpoints that change state (block/unblock, feedback, upload,
# train, archive) require an `X-API-Key: <value>` header.
API_KEY=

# SOAR enforcement. true = rules are recorded and logged only (default).
# false = apply iptables/netsh rules and hosts-file sinkholes (needs root).
SOAR_DRY_RUN=true

# Opt-in live DNS sniffing with scapy (needs root/admin, and Npcap on Windows).
ENABLE_LIVE_CAPTURE=false

# Input limits.
MAX_QUERY_LENGTH=253
MAX_UPLOAD_MB=10

# SQLite location (default: backend/dnsentinel.db).
# DNSENTINEL_DB_PATH=/var/lib/dnsentinel/dnsentinel.db

# --- Threat-intelligence providers (optional; local heuristics otherwise) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# --- Redis cache for intel lookups (optional) ------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
