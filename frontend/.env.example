# Production only: the deployed backend's base URL. Leave unset in development;
# the Vite dev server proxies /api to BACKEND_URL (default http://127.0.0.1:8001).
VITE_API_URL=

# Optional: sent as X-API-Key if the backend sets API_KEY. Anything in a
# browser bundle is public, so this is a deterrent, not a secret.
VITE_API_KEY=
